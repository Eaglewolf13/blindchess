{
  "name": "apex-blindchess",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:webkit": "playwright test --config playwright.webkit.config.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "check": "tsc -b && vitest run",
    "format": "prettier --write --ignore-unknown src scripts tests docs *.ts *.json *.md"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vosk-browser": "^0.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "fflate": "^0.8.2",
    "prettier": "^3.6.2",
    "stockfish": "18.0.5",
    "tar-stream": "^3.1.7",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^4.1.11"
  }
}
